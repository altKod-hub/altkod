---
import { siteData, mainMenu } from "@/data/global";
---
<header class="bg-neutral-100 dark:bg-neutral-900">
    <nav class="flex flex-row flex-wrap justify-between items-center gap-fluid-sm mx-auto p-fluid-sm container">
        <a href="/" class="font-heading font-extrabold transition-colors duration-500 ease-in-out"><span class="text-fuchsia-500">_</span>{siteData.name}</a>
        <ul class="flex flex-row flex-wrap gap-fluid-sm">
            {mainMenu?.map((item) => (
                <li class="flex flex-row flex-wrap gap-fluid-sm">
                    <a href={item.href || "/"} class="bg-neutral-200 hover:bg-zinc-300 dark:bg-neutral-800 dark:hover:bg-neutral-700 px-fluid-xs py-fluid-2xs border-2 border-zinc-300 hover:border-fuchsia-500 dark:border-zinc-700 dark:hover:border-fuchsia-500 rounded-lg font-semibold transition-all duration-500 ease-in-out"><span class="text-fuchsia-500">_</span>{item.label || "Unknown"}</a>
                </li>
            ))}
        </ul>
    </nav>
</header>